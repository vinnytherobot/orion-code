# Database (REQUIRED) - matches docker-compose postgres service
DATABASE_URL=postgresql://orion:orion@localhost:5432/orion

# JWT (REQUIRED - generate a real secret, e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend (REQUIRED)
ORION_API_URL=http://localhost:3000

# LLM provider (optional; defaults to local Ollama)
# Provider name: ollama | openai | anthropic | groq
ORION_PROVIDER=ollama
# Base URL of the Ollama instance the user has installed on the host
ORION_OLLAMA_BASE_URL=http://127.0.0.1:11434
# API key for cloud providers (openai/anthropic/groq). For Ollama this is ignored.
ORION_PROVIDER_API_KEY=
# Per-provider overrides (optional)
# ORION_OPENAI_API_KEY=
# ORION_OPENAI_BASE_URL=https://api.openai.com/v1
# ORION_OPENAI_MODEL=gpt-4o
# ORION_ANTHROPIC_API_KEY=
# ORION_ANTHROPIC_BASE_URL=https://api.anthropic.com
# ORION_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ORION_GROQ_API_KEY=
# ORION_GROQ_BASE_URL=https://api.groq.com/openai/v1
# ORION_GROQ_MODEL=llama-3.3-70b-versatile